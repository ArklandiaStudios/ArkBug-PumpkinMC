     fn travel_in_fluid(&self, caller: &dyn EntityBase, water: bool) {
+        if water && super::passive::squid_swim::is_squid(self.entity.entity_type) {
+            super::passive::squid_swim::travel(caller);
+            return;
+        }
+        if water && super::passive::fish_swim::is_fish(self.entity.entity_type) {
+            super::passive::fish_swim::travel(caller, self.movement_input.load());
+            return;
+        }
         let movement_input = self.movement_input.load();
 
         let falling = self.entity.velocity.load().y <= 0.0;
