+/// Existing Pumpkin root files remain authoritative; Paper/Purpur use the
+/// overworld dimension container for these saved-data files.
+#[must_use]
+pub fn find_data_file(level_folder: &Path, name: &str) -> Option<PathBuf> {
+    let root = minecraft_data_dir(level_folder).join(name);
+    if root.exists() { return Some(root); }
+    let paper = level_folder.join("dimensions/minecraft/overworld/data/minecraft").join(name);
+    paper.exists().then_some(paper)
+}
