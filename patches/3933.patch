+/// Entity interactions commit their mutable hand stack after returning. Mutate
+/// that stack rather than writing a slot that the caller would then overwrite.
+pub(crate) fn exchange_captured_bucket(player: &Player, hand: &mut ItemStack, item: &'static Item) {
+    let creative = player.gamemode.load() == GameMode::Creative;
+    if creative {
+        let inventory = player
+            .inventory
+            .main_inventory
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if inventory.iter().any(|stack| stack.item.id == item.id) {
+            return;
+        }
+        drop(inventory);
+    } else {
+        hand.decrement(1);
+        if hand.is_empty() {
+            *hand = ItemStack::new(1, item);
+            return;
+        }
+    }
+    let mut result = ItemStack::new(1, item);
+    if !player.inventory.insert_stack_anywhere(&mut result) && !creative && !result.is_empty() {
+        player.drop_item(result);
+    }
+}
+
