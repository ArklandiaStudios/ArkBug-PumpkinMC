+/// Plants which intrinsically contain water implement LiquidBlockContainer in vanilla.
+fn is_water_plant(block: &Block) -> bool {
+    block == &Block::SEAGRASS
+        || block == &Block::TALL_SEAGRASS
+        || block == &Block::KELP
+        || block == &Block::KELP_PLANT
+}
+
+fn filled_bucket_target(
+    world: &World,
+    item: &Item,
+    pos: BlockPos,
+    direction: BlockDirection,
+) -> BlockPos {
+    let block = world.get_block(&pos);
+    if item.id != Item::LAVA_BUCKET.id
+        && item.id != Item::POWDER_SNOW_BUCKET.id
+        && (is_water_plant(block) || block.is_waterloggable())
+    {
+        pos
+    } else {
+        pos.offset(direction.to_offset())
+    }
+}
